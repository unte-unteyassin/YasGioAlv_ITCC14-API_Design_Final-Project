# Server
PORT=5000

# Allow the Vite frontend to call this API (adjust if your groupmate's dev port differs)
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Used once by `npm run seed:admin` to create the first admin/lab-technician account.
# Public /auth/register can only ever create role "user" accounts, per the API design.
ADMIN_SEED_NAME=Lab Technician Admin
ADMIN_SEED_EMAIL=admin@xu.edu.ph
ADMIN_SEED_PASSWORD=ChangeMe123!

# Optional: override the SQLite file location (defaults to server/database.sqlite)
# DB_PATH=./database.sqlite
